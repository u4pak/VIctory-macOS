xinput: read Xbox controllers on Bluetooth.

XInput reads a controller's own HID reports. Over Bluetooth, Xbox
controllers report the right stick on Z and Rz, the triggers as Simulation
Brake and Accelerator, the Y axes pointing down, and buttons numbered with
gaps. XInput read the right stick as the triggers and mixed up the
buttons. It now notices that layout and maps it.

--- a/dlls/xinput1_3/main.c
+++ b/dlls/xinput1_3/main.c
@@ -72,6 +72,7 @@
         HIDP_VALUE_CAPS rx_caps;
         HIDP_VALUE_CAPS ry_caps;
         HIDP_VALUE_CAPS rt_caps;
+        BOOL bluetooth_layout;
 
         HANDLE read_event;
         OVERLAPPED read_ovl;
@@ -215,7 +216,7 @@
     HIDP_VALUE_CAPS waveform_caps[8];
     HIDP_BUTTON_CAPS *button_caps;
     ULONG collections_count = 0;
-    HIDP_VALUE_CAPS *value_caps;
+    HIDP_VALUE_CAPS *value_caps, brake_caps = {0}, accelerator_caps = {0};
     int i, u, button_count = 0;
     NTSTATUS status;
 
@@ -245,12 +246,29 @@
     else for (i = 0; i < controller->hid.caps.NumberInputValueCaps; i++)
     {
         HIDP_VALUE_CAPS *caps = value_caps + i;
+        if (caps->UsagePage == HID_USAGE_PAGE_SIMULATION && !caps->IsRange)
+        {
+            if (caps->NotRange.Usage == HID_USAGE_SIMULATION_BRAKE) brake_caps = *caps;
+            if (caps->NotRange.Usage == HID_USAGE_SIMULATION_ACCELERATOR) accelerator_caps = *caps;
+        }
         if (caps->UsagePage != HID_USAGE_PAGE_GENERIC) continue;
         if (!caps->IsRange) check_value_caps(controller, caps->NotRange.Usage, caps);
         else for (u = caps->Range.UsageMin; u <=caps->Range.UsageMax; u++) check_value_caps(controller, u, value_caps + i);
     }
     free(value_caps);
 
+    /* Xbox controllers on Bluetooth: right stick on Z and Rz, triggers on the simulation page */
+    if (!controller->hid.rx_caps.UsagePage && !controller->hid.ry_caps.UsagePage &&
+        brake_caps.UsagePage && accelerator_caps.UsagePage)
+    {
+        TRACE("Xbox Bluetooth layout\n");
+        controller->hid.bluetooth_layout = TRUE;
+        controller->hid.rx_caps = controller->hid.lt_caps;
+        controller->hid.ry_caps = controller->hid.rt_caps;
+        controller->hid.lt_caps = brake_caps;
+        controller->hid.rt_caps = accelerator_caps;
+    }
+
     if (!controller->hid.lt_caps.UsagePage) WARN("Missing axis LeftTrigger\n");
     else caps->Gamepad.bLeftTrigger = (1u << (sizeof(caps->Gamepad.bLeftTrigger) + 1)) - 1;
     if (!controller->hid.rt_caps.UsagePage) WARN("Missing axis RightTrigger\n");
@@ -560,6 +578,10 @@
     return min + MulDiv(tmp - caps->LogicalMin, max - min, caps->LogicalMax - caps->LogicalMin);
 }
 
+/* Xbox controllers on Bluetooth number their buttons with gaps: A 1, B 2, X 4, Y 5,
+ * LB 7, RB 8, View 11, Menu 12, LS 14, RS 15. These are the numbers used below. */
+static const USAGE bluetooth_buttons[16] = {0, 1, 2, 0, 3, 4, 0, 5, 6, 0, 0, 7, 8, 0, 9, 10};
+
 static void read_controller_state(struct xinput_controller *controller)
 {
     ULONG read_len, report_len = controller->hid.caps.InputReportByteLength;
@@ -589,7 +611,9 @@
     state.Gamepad.wButtons = 0;
     for (i = 0; i < button_length; i++)
     {
-        switch (buttons[i])
+        USAGE button = buttons[i];
+        if (controller->hid.bluetooth_layout) button = button < ARRAY_SIZE(bluetooth_buttons) ? bluetooth_buttons[button] : 0;
+        switch (button)
         {
         case 1: state.Gamepad.wButtons |= XINPUT_GAMEPAD_A; break;
         case 2: state.Gamepad.wButtons |= XINPUT_GAMEPAD_B; break;
@@ -650,7 +674,29 @@
     status = HidP_GetUsageValue(HidP_Input, HID_USAGE_PAGE_GENERIC, 0, HID_USAGE_GENERIC_Z, &value, controller->hid.preparsed, report_buf, report_len);
     if (status != HIDP_STATUS_SUCCESS) WARN("HidP_GetUsageValue HID_USAGE_PAGE_GENERIC / HID_USAGE_GENERIC_Z returned %#lx\n", status);
     else state.Gamepad.bLeftTrigger = scale_value(value, &controller->hid.lt_caps, 0, 255);
+
+    if (controller->hid.bluetooth_layout)
+    {
+        /* its Y axes point down, XInput's up */
+        state.Gamepad.sThumbLY = -1 - state.Gamepad.sThumbLY;
+
+        status = HidP_GetUsageValue(HidP_Input, HID_USAGE_PAGE_GENERIC, 0, HID_USAGE_GENERIC_Z, &value, controller->hid.preparsed, report_buf, report_len);
+        if (status != HIDP_STATUS_SUCCESS) WARN("HidP_GetUsageValue HID_USAGE_PAGE_GENERIC / HID_USAGE_GENERIC_Z returned %#lx\n", status);
+        else state.Gamepad.sThumbRX = scale_value(value, &controller->hid.rx_caps, -32768, 32767);
+
+        status = HidP_GetUsageValue(HidP_Input, HID_USAGE_PAGE_GENERIC, 0, HID_USAGE_GENERIC_RZ, &value, controller->hid.preparsed, report_buf, report_len);
+        if (status != HIDP_STATUS_SUCCESS) WARN("HidP_GetUsageValue HID_USAGE_PAGE_GENERIC / HID_USAGE_GENERIC_RZ returned %#lx\n", status);
+        else state.Gamepad.sThumbRY = -1 - scale_value(value, &controller->hid.ry_caps, -32768, 32767);
 
+        status = HidP_GetUsageValue(HidP_Input, HID_USAGE_PAGE_SIMULATION, 0, HID_USAGE_SIMULATION_BRAKE, &value, controller->hid.preparsed, report_buf, report_len);
+        if (status != HIDP_STATUS_SUCCESS) WARN("HidP_GetUsageValue HID_USAGE_PAGE_SIMULATION / HID_USAGE_SIMULATION_BRAKE returned %#lx\n", status);
+        else state.Gamepad.bLeftTrigger = scale_value(value, &controller->hid.lt_caps, 0, 255);
+
+        status = HidP_GetUsageValue(HidP_Input, HID_USAGE_PAGE_SIMULATION, 0, HID_USAGE_SIMULATION_ACCELERATOR, &value, controller->hid.preparsed, report_buf, report_len);
+        if (status != HIDP_STATUS_SUCCESS) WARN("HidP_GetUsageValue HID_USAGE_PAGE_SIMULATION / HID_USAGE_SIMULATION_ACCELERATOR returned %#lx\n", status);
+        else state.Gamepad.bRightTrigger = scale_value(value, &controller->hid.rt_caps, 0, 255);
+    }
+
     EnterCriticalSection(&controller->crit);
     if (controller->enabled)
     {
